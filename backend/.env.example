# Somente desenvolvimento local; nunca versione valores reais.
# DB_NAME abaixo corresponde ao bootstrap/healthcheck do Compose.
# Para avaliar/testar: DB_NAME=jungle_wagering_test no comando.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=jungle_wagering
DB_USER=jungle
DB_PASSWORD=change_me
PORT=3000

# Local emulator only; the SDK uses fixed dummy credentials.
SQS_ENDPOINT=http://127.0.0.1:4566
AWS_REGION=us-east-1
SQS_COMMAND_QUEUE=wager-transactions.fifo
SQS_COMMAND_DLQ=wager-transactions-dlq.fifo
SQS_EVENT_QUEUE=wager-events.fifo
SQS_EVENT_DLQ=wager-events-dlq.fifo
